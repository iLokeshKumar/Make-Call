# Copy to .env and fill values
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:6060/crm/linkedin/callback
LINKEDIN_API_BASE=https://api.linkedin.com
# Shared secret option (simple): Rio portal and MCP share this value
RIO_SECRET=replace-with-secure-value
# Optional legacy API key name kept for compatibility
RIO_API_KEY=
# JWT option (recommended for production): set a strong secret or use asymmetric keys
RIO_JWT_SECRET=
RIO_JWT_ALGORITHM=HS256

RIO_WEBHOOK_URL=
DATABASE_URL=sqlite:///./mcp_linkedin.db
APP_HOST=0.0.0.0
APP_PORT=8000
