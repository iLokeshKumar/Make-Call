# --- SERVER CONFIGURATION ---
PORT=6060
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Public Domain (ngrok) - Required for webhooks (e.g., https://your-id.ngrok-free.app)
DOMAIN=

# --- VOICE & AI ENGINE ---
# Primary engine toggle: 'gemini' or 'mistral'
VOICE_ENGINE=gemini
# AI Verbosity: '1' (Concise), '2' (Balanced), '3' (Detailed)
AI_VERBOSITY=2

# --- LLM PROVIDERS ---
# Google Gemini: Get key at https://aistudio.google.com/
GEMINI_API_KEY=
# Mistral AI: Get key at https://console.mistral.ai/
MISTRAL_API_KEY=
# Qwen (Alibaba Cloud)
QWEN_API_KEY=

# --- SPEECH-TO-TEXT (STT) ---
# Deepgram: Get key at https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Sarvam AI (India Optimized): Get key at https://www.sarvam.ai/
SARVAM_API_KEY=

# --- TEXT-TO-SPEECH (TTS) ---
# Cartesia (Ultra-fast): Get key at https://play.cartesia.ai/
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# ElevenLabs: Get key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Deepgram Aura TTS
DEEPGRAM_VOICE=aura-asteria-en

# --- TELEPHONY PROVIDERS ---
# Twilio: Get credentials at https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PHONE_NUMBER_FROM=

# EnableX: Get credentials at https://portal.enablex.io/
EnableX_App_ID=
EnableX_App_Key=
ENABLEX_FROM_NUMBER=

# Exotel (India Optimized): Get credentials at https://my.exotel.com/
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_REGION=Singapore
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PORTAL_URL=https://my.exotel.com
EXOTEL_APP_ID=
EXOPHONE=

# --- SEARCH & DATA ENRICHMENT ---
# Apollo.io: Get key at https://app.apollo.io/
APOLLO_API_KEY=
# Exa AI (Search): Get key at https://exa.ai/
EXA_API_KEY=

# --- EMAIL SERVICE (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# --- GOOGLE OAUTH ---
# Required for Calendar integrations
Client_ID=
Client_Secret=

# --- SYSTEM OPTIMIZATIONS ---
# Uncomment to fix OpenBLAS/MKL memory allocation errors if hitting thread limits
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OMP_NUM_THREADS=1
SELECT * FROM interaction;
SELECT COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, IS_NULLABLE, COLUMN_DEFAULT
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'interaction';

SELECT * FROM lead;
SELECT * FROM product;
SELECT * FROM systemsettings;
SELECT * FROM appointment;
SELECT * FROM "user";
SELECT COUNT(*) FROM appointment;
SELECT email FROM lead WHERE id = 2;
SELECT COUNT(*) FROM interaction WHERE id = 84;
ALTER TABLE "user" ADD COLUMN mfa_disable_otp VARCHAR;
SELECT * FROM latencylog;
SELECT * FROM demo;
ALTER TABLE "user" ADD COLUMN first_name VARCHAR;
ALTER TABLE "user" ADD COLUMN last_name VARCHAR;
ALTER TABLE "user" ADD COLUMN phone_number VARCHAR;
ALTER TABLE "user" ADD COLUMN profile_picture_url VARCHAR;
ALTER TABLE "user" ADD COLUMN reveal_otp VARCHAR;
ALTER TABLE "user" ADD COLUMN reveal_otp_expires_at TIMESTAMP WITH TIME ZONE;

CREATE TABLE demo (
    -- Primary Key
    id SERIAL PRIMARY KEY,
    
    -- Foreign Key to Leads
    lead_id INTEGER NOT NULL,
    
    -- Contact Details
    name VARCHAR(255) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    email VARCHAR(255),
    
    -- Location Details
    city VARCHAR(100),
    state VARCHAR(100),
    pincode VARCHAR(20),
    
    -- Demo Metadata
    demo_date TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(50) DEFAULT 'Scheduled',
    notes TEXT,
    
    -- AuditMixin Fields
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    created_by VARCHAR(255) DEFAULT 'System',
    updated_by VARCHAR(255),

    -- Constraints
    CONSTRAINT fk_lead FOREIGN KEY (lead_id) REFERENCES lead(id) ON DELETE CASCADE
);

-- Index for faster lookups by lead
CREATE INDEX idx_demo_lead_id ON demo(lead_id);
SELECT * FROM demo;

ALTER TABLE demo ADD COLUMN products TEXT;

ALTER TABLE "user" ADD COLUMN google_access_token TEXT;
ALTER TABLE "user" ADD COLUMN google_refresh_token TEXT;
ALTER TABLE "user" ADD COLUMN google_token_expiry TIMESTAMP;
ALTER TABLE "user" ADD COLUMN google_account_email VARCHAR(255);

ALTER TABLE demo ADD COLUMN demo_type VARCHAR(50) DEFAULT 'Offline';
ALTER TABLE demo ADD COLUMN IF NOT EXISTS google_meet_link VARCHAR;
ALTER TABLE appointment ADD COLUMN IF NOT EXISTS google_meet_link VARCHAR;
ALTER TABLE appointment ADD COLUMN IF NOT EXISTS calendar_event_id VARCHAR;
ALTER TABLE demo ADD COLUMN IF NOT EXISTS calendar_event_id VARCHAR;
TRUNCATE TABLE latencylog;
ALTER TABLE demo
RENAME COLUMN google_meet_link TO meeting_link;
ALTER TABLE appointment
RENAME COLUMN google_meet_link TO meeting_link;

ALTER TABLE systemsettings ADD COLUMN user_id INTEGER;
ALTER TABLE systemsettings ADD CONSTRAINT fk_systemsettings_user_id FOREIGN KEY (user_id) REFERENCES "user" (id) ON DELETE CASCADE;
CREATE INDEX ix_systemsettings_user_id ON systemsettings (user_id);
