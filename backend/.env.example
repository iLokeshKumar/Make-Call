# --- SERVER CONFIGURATION ---
PORT=6060
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Public Domain (ngrok) - Required for webhooks (e.g., https://your-id.ngrok-free.app)
DOMAIN=
# Frontend base URL - used for tracking links (unsubscribe, open pixel, click redirect)
FRONTEND_BASE_URL=http://localhost:3006

# --- VOICE & AI ENGINE ---
# Primary engine toggle: 'gemini' or 'mistral'
VOICE_ENGINE=gemini
# AI Verbosity: '1' (Concise), '2' (Balanced), '3' (Detailed)
AI_VERBOSITY=2
# Silero-VAD confirmation gate on barge-in (0=off, 1=on).
# When enabled, RMS-triggered barges are confirmed by Silero before pausing
# the agent.  Cuts false positives from background noise / plosives at the
# cost of ~30ms per frame.  Requires `silero-vad` + `torch` installed.
USE_SILERO_VAD=0
# Optional path to a pre-downloaded Silero JIT model (offline installs).
# Leave empty to let silero_vad.load_silero_vad() fetch on first use.
SILERO_VAD_MODEL_PATH=

# --- CALL BUSINESS HOURS GUARD ---
# Dialer refuses to place calls outside this window in the lead's local TZ.
# Monday-Saturday only by default.
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=22
# 1 = block Sundays, 0 = allow Sundays
BUSINESS_SUNDAY_BLOCKED=1
# Set to 1 to short-circuit the entire check (dev use only!)
DISABLE_BUSINESS_HOURS_GUARD=0

# --- LLM PROVIDERS ---
# Google Gemini: Get key at https://aistudio.google.com/
GEMINI_API_KEY=
# Mistral AI: Get key at https://console.mistral.ai/
MISTRAL_API_KEY=
# Qwen (Alibaba Cloud)
QWEN_API_KEY=

# --- SPEECH-TO-TEXT (STT) ---
# Deepgram: Get key at https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Sarvam AI (India Optimized): Get key at https://www.sarvam.ai/
SARVAM_API_KEY=

# --- TEXT-TO-SPEECH (TTS) ---
# Cartesia (Ultra-fast): Get key at https://play.cartesia.ai/
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# ElevenLabs: Get key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Deepgram Aura TTS
DEEPGRAM_VOICE=aura-asteria-en

# --- TELEPHONY PROVIDERS ---
# Twilio: Get credentials at https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PHONE_NUMBER_FROM=

# EnableX: Get credentials at https://portal.enablex.io/
EnableX_App_ID=
EnableX_App_Key=
ENABLEX_FROM_NUMBER=

# Exotel (India Optimized): Get credentials at https://my.exotel.com/
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_REGION=Singapore
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PORTAL_URL=https://my.exotel.com
EXOTEL_APP_ID=
EXOPHONE=

# --- SEARCH & DATA ENRICHMENT ---
# Apollo.io: Get key at https://app.apollo.io/
APOLLO_API_KEY=
# Exa AI (Search): Get key at https://exa.ai/
EXA_API_KEY=

# --- EMAIL SERVICE (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- GOOGLE OAUTH ---
# Required for Calendar integrations
Client_ID=
Client_Secret=

# --- SYSTEM OPTIMIZATIONS ---
# Uncomment to fix OpenBLAS/MKL memory allocation errors if hitting thread limits
# OPENBLAS_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OMP_NUM_THREADS=1