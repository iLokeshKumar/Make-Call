# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/rio_crm
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=0
SQL_ECHO_POOL=0

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here
CSRF_SECRET=your-csrf-secret-here

# Telephony - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telephony - EnableX
ENABLEX_APP_ID=
ENABLEX_APP_KEY=
ENABLEX_FROM_NUMBER=

# Telephony - Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Telephony - Vobiz
VOBIZ_API_KEY=

# Telephony - Exotel
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOPHONE=

# AI Services - Speech
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-asteria-en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
SARVAM_API_KEY=
GLADIA_API_KEY=
ASSEMBLYAI_API_KEY=
RINGG_API_KEY=

# AI Services - LLM
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Lead Enrichment
APOLLO_API_KEY=
LUSHA_API_KEY=
ZOOMINFO_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Profile page Google OAuth (user identity / Gmail)
GOOGLE_PROFILE_REDIRECT_URI=http://localhost:3006/profile
# Settings page Google Calendar OAuth (agent calendar write access)
GOOGLE_REDIRECT_URI=http://localhost:6060/crm/calendar/callback
FRONTEND_URL=http://localhost:3006

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rio-crm
SENTRY_DSN=

# Feature Flags
RLS_WARN_ON_MISSING=1
USE_SILERO_VAD=0
DISABLE_BARGE_IN=0

# Worker Configuration
WORKER_POLL_INTERVAL=60
WORKER_BATCH_SIZE=10

# CORS
ALLOWED_ORIGINS=http://localhost:3006,http://localhost:3000

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata